   "source": [
    "import numpy as np\n",
    "\n",
    "def RMSNorm(x, gamma = 0.9, eps = 1e-8):\n",
    "    # x shape (batch_size, dim)\n",
    "    v = np.sqrt((x ** 2).mean(axis = -1, keepdims = True) + eps)\n",
    "    x = gamma * x / v\n",
    "    return x\n",
    "\n",
    "x = np.array([\n",
    "    [1, 2, 3],\n",
    "    [4, 5, 6]\n",
    "])\n",
    "x = RMSNorm(x)\n",
    "print(x)"
   ]
  }
 ],
